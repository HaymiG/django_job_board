DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# - For PostgreSQL set DB_ENGINE=postgres and fill credentials below.
# - For SQLite omit DB_ENGINE or set it to sqlite.
DB_ENGINE=postgres
DB_NAME=jobboard
DB_USER=jobboard_user
DB_PASSWORD=jobboard_pass
DB_HOST=127.0.0.1
DB_PORT=5432

