DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# - For PostgreSQL set DB_ENGINE=postgres and fill credentials below.
# - For SQLite omit DB_ENGINE or set it to sqlite.
DB_ENGINE=postgres
DB_NAME=jobboard
DB_USER=jobboard_user
DB_PASSWORD=jobboard_pass
DB_HOST=127.0.0.1
DB_PORT=5432

# Email
# Development: console backend — emails printed to terminal, no SMTP needed.
# Production:  switch to smtp backend and fill the SMTP_* vars below.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=JobBoard <noreply@yourdomain.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=JobBoard <noreply@jobboard.local>
