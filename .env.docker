# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — Environment variables for the Docker Compose stack
#
# This file is loaded by docker-compose.yml via `env_file: .env.docker`.
# It is safe to commit as long as you use placeholder values here and
# override secrets via your hosting provider or CI secrets in production.
#
# IMPORTANT: Do NOT commit real passwords or secret keys to git.
#            In production use your hosting platform's secrets management.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — these MUST match the postgres service in docker-compose.yml
DB_ENGINE=postgres
DB_NAME=jobboard
DB_USER=jobboard_user
DB_PASSWORD=jobboard_pass
# DB_HOST is set in docker-compose.yml environment block (overrides this)
DB_HOST=db
DB_PORT=5432

# Email — use console backend in Docker dev, switch to SMTP for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=JobBoard <noreply@jobboard.local>

# For real email delivery in production, uncomment and fill these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
