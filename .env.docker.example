# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Template for Docker Compose environment variables
#
# HOW TO USE:
#   cp .env.docker.example .env.docker
#   # Then edit .env.docker and set a real DJANGO_SECRET_KEY
#
# .env.docker  →  loaded by docker-compose.yml (your real config, git-ignored)
# .env.docker.example  →  this file, safe to commit (placeholder values only)
#
# IMPORTANT: Never commit real passwords or secret keys to git.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — these MUST match the postgres service in docker-compose.yml
DB_ENGINE=postgres
DB_NAME=jobboard
DB_USER=jobboard_user
DB_PASSWORD=jobboard_pass
# DB_HOST is overridden in docker-compose.yml (service name: db)
DB_HOST=db
DB_PORT=5432

# Email — console backend prints emails to terminal (no SMTP needed in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=JobBoard <noreply@jobboard.local>

# For real email delivery in production, uncomment and fill these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
